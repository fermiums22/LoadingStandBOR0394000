[Unit]
Description=Loading-stand UART (ttyAMA5) to TCP bridge for DriveScope
# Start only after the self-written AP-fallback script has settled the network
# (smart-wifi.service is a oneshot that joins Wi-Fi or raises the hotspot).
After=network.target smart-wifi.service
Wants=smart-wifi.service

[Service]
Type=simple
User=pi
SupplementaryGroups=dialout
ExecStart=/usr/bin/python3 /home/pi/uart_bridge.py /dev/ttyAMA5 921600 5555
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
